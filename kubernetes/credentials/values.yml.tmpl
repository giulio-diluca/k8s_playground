# ==========================================
# REPOSITORY & REGISTRY CREDENTIALS
# ==========================================

# 1. Argo CD Repo Credentials
gitRepo:
  url: "https://github.com/giulio-diluca/k8s_playground.git"
  username: "REPLACE_WITH_GITHUB_USERNAME"
  token: "REPLACE_WITH_GITHUB_PAT"

# 2. GHCR Pull Secret
ghcr:
  username: "REPLACE_WITH_GITHUB_USERNAME"
  password: "REPLACE_WITH_GITHUB_PAT"

# 3. Docker Hub Pull Secret
dockerhub:
  username: "REPLACE_WITH_DOCKER_USERNAME"
  password: "REPLACE_WITH_DOCKER_TOKEN"
  email: "your-email@example.com"